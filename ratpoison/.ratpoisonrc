# Common settings

   set winname class
   defborder 1
   defpadding 0 0 0 0
   defbarpadding 0 0
   set font Iosevka:size=14
   set bargravity center
   set inputwidth 400
   exec ratpoison -c banish

# system startup

   exec xset r rate 250 100
   exec emacs &

# window color (ratpoison windows)

  set bgcolor #000000
  set fgcolor #FFFFFF

# active and inactive window color

  set fwcolor white
  set bwcolor gray30

# set term to kitty

  alias term exec kitty
  bind C exec kitty
  bind c select kitty

# Common bindings

  escape C-t

  bind w windows
  bind r restart
  bind k kill

  bind E exec emacs
  bind e select Emacs
  bind g select firefox
  bind G exec firefox

  bind z exec scrot -e 'mv $f ~/Pictures/Screenshots/'
  bind d exec dmenu_run -fn Iosevka
  bind y exec dock

# Movement bindings

  bind h focusleft
  bind j focusdown
  bind k focusup
  bind l focusright

  definekey top M-j next
  definekey top M-k prev

# workspaces

   exec /usr/bin/rpws init 4 -k
   bind C-1 exec rpws 1
   bind C-2 exec rpws 2
   bind C-3 exec rpws 3
   bind C-4 exec rpws 4

# scripts
