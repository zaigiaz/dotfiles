;;;; ~/.stumpwmrc

(in-package :stumpwm)

;;; Common settings

(setf *window-border-style* :thin
      *normal-border-width* 1
      *message-window-padding* 0
      *input-window-width* 400
      *bar-gravity* :center
      *font* "Iosevka:size=14"
      *foreground-color* "#ffffff"
      *background-color* "#000000"
      *normal-border-color* "#4d4d4d"
      *selected-window-border-color* "#ffffff")

;;; Startup commands
(run-shell-command "xset r rate 250 90")
(run-shell-command "feh --bg-fill ~/Pictures/Albert_Bierstadt_-_California_Spring_-_Google_Art_Project.jpg")

;;; Helper commands
(defcommand launch-terminal () ()
  (run-shell-command "alacritty"))

(defcommand launch-emacs () ()
  (run-shell-command "emacs"))

(defcommand launch-firefox () ()
  (run-shell-command "firefox"))

(defcommand launch-lock-screen () ()
  (run-shell-command "xlock -mode helix"))

(defcommand take-screenshot () ()
  (run-shell-command
   "scrot -s ~/Pictures/Screenshots/%Y%m%d-%H%M%S.png"))

(defcommand select-emacs () ()
  (select-window-by-name "Emacs"))

(defcommand select-emacs () ()
  (select-window-by-name "alacritty"))

(defcommand select-firefox () ()
  (selectf-window-by-name "Firefox"))

;;; Key bindings

(define-key *root-map* (kbd "w") "windows")

(define-key *root-map* (kbd "K") "delete-window")

;; Common Bindings
(define-key *root-map* (kbd "M-R") "restart-soft")

(define-key *root-map* (kbd "C") "launch-terminal")
(define-key *root-map* (kbd "c") "select-terminal")
(define-key *root-map* (kbd "E") "launch-emacs")
(define-key *root-map* (kbd "e") "select-emacs")
(define-key *root-map* (kbd "G") "launch-firefox")
(define-key *root-map* (kbd "g") "select-firefox")

(define-key *root-map* (kbd "L") "launch-lock-screen")
(define-key *root-map* (kbd "z") "take-screenshot")

(define-key *root-map* (kbd "h") "move-focus left")
(define-key *root-map* (kbd "j") "move-focus down")
(define-key *root-map* (kbd "k") "move-focus up")
(define-key *root-map* (kbd "l") "move-focus right")

(define-key *top-map* (kbd "M-j") "next")
(define-key *top-map* (kbd "M-k") "prev")

;; Ensure the current screen has groups named 1, 2, 3, and 4.
(unless (find-group (current-screen) "1")
  (grename "1"))

(dolist (name '("2" "3" "4"))
  (unless (find-group (current-screen) name)
    (gnew name)))

;; Switch groups with C-t C-1 through C-t C-4.
(define-key *root-map* (kbd "C-1") "gselect 1")
(define-key *root-map* (kbd "C-2") "gselect 2")
(define-key *root-map* (kbd "C-3") "gselect 3")
(define-key *root-map* (kbd "C-4") "gselect 4")

;; Black modeline with white text
(setf *mode-line-background-color* "black"
      *mode-line-foreground-color* "white"
      *group-format* "%n"
      *mode-line-timeout* 15
      *mode-line-border-width* 0)

(setf *screen-mode-line-format*
      (list "[%g]  ^>  %d"))

(mode-line)
